#: includes/class-minn-admin-db.php:329
#: includes/class-minn-admin-db.php:357
#: includes/class-minn-admin-db.php:466
msgid "Unknown table."
msgstr "جدول ناشناخته است."

#: includes/class-minn-admin-db.php:333
#: includes/class-minn-admin-db.php:361
msgid "Could not read the table structure."
msgstr "ساختار جدول خوانده نشد."

#: includes/class-minn-admin-db.php:472
msgid "This table has no usable primary key."
msgstr "این جدول کلید اصلی قابل‌استفاده‌ای ندارد."

#: includes/class-minn-admin-db.php:482
msgid "Row not found."
msgstr "ردیف پیدا نشد."

#: includes/class-minn-admin-db.php:541
msgid "Not checked"
msgstr "بررسی‌نشده"

#: includes/class-minn-admin-db.php:542
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "این جدول برای شمارش سریع بیش از حد بزرگ است؛ بنابراین Minn آن را اسکن نمی‌کند. برای بررسی دستی، فرمان زیر را اجرا کنید."

#: includes/class-minn-admin-db.php:592
msgid "Database hygiene"
msgstr "پاکیزگی پایگاه داده"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:598
#, php-format
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s بررسی ذخیره‌سازی نیازمند توجه است"
msgstr[1] "%s بررسی ذخیره‌سازی نیازمند توجه‌اند"

#: includes/class-minn-admin-db.php:606
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "ردیف‌های یتیم، ایندکس‌ها و موتورهای ذخیره‌سازی همگی سالم‌اند"

#: includes/class-minn-admin-db.php:670
msgid "Tables without a primary key"
msgstr "جدول‌های بدون کلید اصلی"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:676
#, php-format
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "این جدول‌ها کلید اصلی ندارند؛ این وضعیت همانندسازی در سطح ردیف را مختل می‌کند و ابزارهای پشتیبان‌گیری و انتقال را به خطا می‌اندازد: %s"

#: includes/class-minn-admin-db.php:679
msgid "Every table has a primary key."
msgstr "همهٔ جدول‌ها کلید اصلی دارند."

#: includes/class-minn-admin-db.php:691
msgid "Storage engine"
msgstr "موتور ذخیره‌سازی"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:697
#, php-format
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "این جدول‌ها از InnoDB استفاده نمی‌کنند؛ بنابراین قفل‌گذاری در سطح ردیف و بازیابی پس از خرابی را ندارند: %s"

#: includes/class-minn-admin-db.php:700
msgid "Every table uses InnoDB."
msgstr "همهٔ جدول‌ها از InnoDB استفاده می‌کنند."

#: includes/class-minn-admin-db.php:702
msgid "Convert a table"
msgstr "تبدیل جدول"

#: includes/class-minn-admin-db.php:704
msgid "Back up first. Converting locks the table while it runs."
msgstr "ابتدا پشتیبان بگیرید. تبدیل، جدول را هنگام اجرا قفل می‌کند."

#: includes/class-minn-admin-db.php:723
msgid "Reclaimable space"
msgstr "فضای قابل‌بازیابی"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:730
#, php-format
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "%1$s به‌تنهایی %2$s فضای آزاد را در فایل خود نگه داشته است. بهینه‌سازی، جدول را بازنویسی و این فضا را به دیسک بازمی‌گرداند."

#: includes/class-minn-admin-db.php:734
msgid "No table is holding a significant amount of reclaimable space."
msgstr "هیچ جدولی فضای قابل‌بازیابی قابل‌توجهی نگه نداشته است."

#: includes/class-minn-admin-db.php:736
msgid "Optimise tables"
msgstr "بهینه‌سازی جدول‌ها"

#: includes/class-minn-admin-db.php:738
msgid "Back up first. Optimising locks each table while it runs."
msgstr "ابتدا پشتیبان بگیرید. بهینه‌سازی، هر جدول را هنگام اجرا قفل می‌کند."

#: includes/class-minn-admin-db.php:756
msgid "Post meta lookup index"
msgstr "ایندکس جست‌وجوی فرادادهٔ نوشته"

#: includes/class-minn-admin-db.php:759
msgid "Present"
msgstr "موجود"

#: includes/class-minn-admin-db.php:759
msgid "Missing"
msgstr "ناموجود"

#: includes/class-minn-admin-db.php:761
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "ایندکس ترکیبی post_id و meta_key موجود است؛ بنابراین جست‌وجوی فراداده سریع می‌ماند."

#: includes/class-minn-admin-db.php:762
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "جست‌وجو بر پایهٔ نوشته و کلید فراداده به دو ایندکس جدا متکی است. در سایت‌های پُراستفاده از فراداده (WooCommerce و افزونه‌های رویداد و رزرو)، یک ایندکس ترکیبی با ریسک کم، سرعت را به‌طور محسوسی افزایش می‌دهد."

#: includes/class-minn-admin-db.php:764
msgid "Add the index"
msgstr "افزودن ایندکس"

#: includes/class-minn-admin-db.php:766
msgid "Back up first. Adding an index locks the table briefly."
msgstr "ابتدا پشتیبان بگیرید. افزودن ایندکس، جدول را برای مدت کوتاهی قفل می‌کند."

#: includes/class-minn-admin-db.php:805
msgid "Auto-increment headroom"
msgstr "ظرفیت باقی‌ماندهٔ افزایش خودکار"

#: includes/class-minn-admin-db.php:807
msgid "Healthy"
msgstr "سالم"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:812
#, php-format
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "این جدول‌ها به ۲۰ درصد پایانیِ بیشترین شناسهٔ قابل‌ذخیره در نوع ستون خود رسیده‌اند. با رسیدن به سقف، نوشتن ردیف‌های تازه متوقف می‌شود: %s"

#: includes/class-minn-admin-db.php:815
msgid "No table is close to exhausting its id column."
msgstr "هیچ جدولی به پر شدن ظرفیت ستون شناسهٔ خود نزدیک نیست."

#: includes/class-minn-admin-db.php:823
msgid "Orphaned post meta"
msgstr "فرادادهٔ یتیم نوشته‌ها"

#: includes/class-minn-admin-db.php:826
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "این ردیف‌های فراداده متعلق به نوشته‌هایی هستند که دیگر وجود ندارند و در هر کوئریِ فرادادهٔ نوشته سربار ایجاد می‌کنند."

#: includes/class-minn-admin-db.php:827
msgid "Every meta row belongs to a post that still exists."
msgstr "هر ردیف فراداده به نوشته‌ای موجود تعلق دارد."

#: includes/class-minn-admin-db.php:829
#: includes/class-minn-admin-db.php:847
#: includes/class-minn-admin-db.php:865
msgid "Delete them"
msgstr "حذف آن‌ها"

#: includes/class-minn-admin-db.php:831
#: includes/class-minn-admin-db.php:849
#: includes/class-minn-admin-db.php:867
msgid "Back up first. This permanently deletes rows."
msgstr "ابتدا پشتیبان بگیرید. این کار ردیف‌ها را برای همیشه حذف می‌کند."

#: includes/class-minn-admin-db.php:841
msgid "Orphaned user meta"
msgstr "فرادادهٔ یتیم کاربران"

#: includes/class-minn-admin-db.php:844
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "این ردیف‌های فراداده متعلق به کاربرانی هستند که دیگر وجود ندارند؛ معمولاً افزونه‌ای که حساب‌ها را مستقیم حذف کرده آن‌ها را باقی گذاشته است."

#: includes/class-minn-admin-db.php:845
msgid "Every meta row belongs to a user who still exists."
msgstr "هر ردیف فراداده به کاربری موجود تعلق دارد."

#: includes/class-minn-admin-db.php:859
msgid "Orphaned term relationships"
msgstr "رابطه‌های یتیم رده‌ها"

#: includes/class-minn-admin-db.php:862
msgid "These rows link content to categories or tags that no longer exist."
msgstr "این ردیف‌ها محتوا را به دسته‌ها یا برچسب‌هایی پیوند می‌دهند که دیگر وجود ندارند."

#: includes/class-minn-admin-db.php:863
msgid "Every relationship points at a term that still exists."
msgstr "هر رابطه به رده‌ای موجود اشاره می‌کند."

#: includes/class-minn-admin-db.php:877
msgid "Stored revisions"
msgstr "رونوشت‌های ذخیره‌شده"

#: includes/class-minn-admin-db.php:880
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "رونوشت‌ها شبکهٔ ایمنی ویرایشگرند؛ بنابراین تعداد زیاد آن‌ها طبیعی است و ایراد محسوب نمی‌شود. حذفشان فقط وقتی ارزش دارد که جدول نوشته‌ها بیش از حد بزرگ شده باشد."

#: includes/class-minn-admin-db.php:881
msgid "No revisions are stored."
msgstr "هیچ رونوشتی ذخیره نشده است."

#: includes/class-minn-admin-db.php:883
msgid "Delete all revisions"
msgstr "حذف همهٔ رونوشت‌ها"

#: includes/class-minn-admin-db.php:885
msgid "Back up first. This removes every saved revision permanently."
msgstr "ابتدا پشتیبان بگیرید. این کار همهٔ رونوشت‌های ذخیره‌شده را برای همیشه حذف می‌کند."

#: includes/class-minn-admin-db.php:895
msgid "Spam and trashed comments"
msgstr "دیدگاه‌های جفنگ و زباله‌دان"

#: includes/class-minn-admin-db.php:898
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "دیدگاه‌های جفنگ و زباله‌دان تا زمان تخلیه در پایگاه داده می‌مانند. وردپرس پس از مدتی آن‌ها را خودکار پاک می‌کند."

#: includes/class-minn-admin-db.php:899
msgid "No spam or trashed comments are waiting."
msgstr "هیچ دیدگاه جفنگ یا زباله‌دانی در انتظار حذف نیست."

#: includes/class-minn-admin-db.php:901
msgid "Delete spam"
msgstr "حذف جفنگ‌ها"

#: includes/class-minn-admin-db.php:903
msgid "Back up first. This permanently deletes the comments."
msgstr "ابتدا پشتیبان بگیرید. این کار دیدگاه‌ها را برای همیشه حذف می‌کند."

#: includes/class-minn-admin-db.php:914
msgid "Expired WooCommerce sessions"
msgstr "نشست‌های منقضی‌شدهٔ WooCommerce"

#: includes/class-minn-admin-db.php:917
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "نشست‌های منقضی‌شدهٔ سبد خرید باید با یک وظیفهٔ زمان‌بندی‌شدهٔ WooCommerce پاک شوند. انباشت زیاد معمولاً یعنی آن وظیفه دیگر اجرا نمی‌شود."

#: includes/class-minn-admin-db.php:918
msgid "No expired sessions are left behind."
msgstr "هیچ نشست منقضی‌شده‌ای باقی نمانده است."

#: includes/class-minn-admin-db.php:920
msgid "Delete expired sessions"
msgstr "حذف نشست‌های منقضی"

#: includes/class-minn-admin-db.php:922
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "ابتدا پشتیبان بگیرید. خریداران سبد منقضی‌شده آن را از دست می‌دهند؛ اتفاقی که طبق تعریف از قبل رخ داده است."

#: includes/class-minn-admin-db.php:933
msgid "Action Scheduler backlog"
msgstr "صف عقب‌افتادهٔ Action Scheduler"

#: includes/class-minn-admin-db.php:936
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "کارهای پس‌زمینهٔ در انتظار و ناموفق. یک صف ثابت در فروشگاه شلوغ طبیعی است؛ اما صف بسیار بزرگ نشان می‌دهد که صف تخلیه نمی‌شود."

#: includes/class-minn-admin-db.php:937
msgid "No pending or failed background jobs."
msgstr "هیچ کار پس‌زمینهٔ در انتظار یا ناموفقی وجود ندارد."

#: includes/class-minn-admin-db.php:939
msgid "Clean the queue"
msgstr "پاک‌سازی صف"

#: includes/class-minn-admin-db.php:941
msgid "Removes finished actions. Pending work is left alone."
msgstr "عملیات پایان‌یافته را حذف می‌کند و به کارهای در انتظار دست نمی‌زند."

#: includes/class-minn-admin-rest.php:1907
msgid "That block does not offer image editing here."
msgstr "آن بلوک امکان ویرایش تصویر را در اینجا ارائه نمی‌دهد."

#: includes/class-minn-admin-rest.php:1928
msgid "Pick at least one image."
msgstr "دست‌کم یک تصویر انتخاب کنید."

#: includes/class-minn-admin-rest.php:1937
msgid "That block could not be rebuilt for those images."
msgstr "بازسازی آن بلوک برای این تصاویر ممکن نبود."

#: includes/class-minn-admin-rest.php:2250
msgid "Pattern not found."
msgstr "الگو پیدا نشد."

#: includes/class-minn-admin-rest.php:3402
msgid "Automatic updates are turned off for this site."
msgstr "به‌روزرسانی خودکار برای این سایت خاموش است."

#: includes/class-minn-admin-rest.php:3411
msgid "Unknown plugin."
msgstr "افزونهٔ ناشناخته."

#: includes/class-minn-admin-rest.php:3411
msgid "Unknown theme."
msgstr "پوستهٔ ناشناخته."

#. translators: 1: admin name, 2: subject
#: includes/class-minn-admin-rest.php:3999
#, php-format
msgid "Minn Admin email sent by %1$s: %2$s"
msgstr "ایمیل Minn Admin توسط %1$s ارسال شد: %2$s"

#. translators: 1: email title, 2: admin name
#: includes/class-minn-admin-rest.php:4227
#, php-format
msgid "“%1$s” email resent via Minn Admin by %2$s."
msgstr "ایمیل «%1$s» توسط %2$s از طریق Minn Admin دوباره ارسال شد."

#: includes/class-minn-admin-surfaces.php:240
#: assets/js/app.js:698
#: assets/js/app.js:1561
msgid "Content"
msgstr "محتوا"

#: includes/class-minn-admin-surfaces.php:241
#: assets/js/app.js:699
#: assets/js/app.js:1562
