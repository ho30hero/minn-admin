 \u0628\u062e\u0634 \u0641\u0642\u0637 \u0645\u062a\u0646 \u0633\u0627\u062f\u0647 \u0627\u0633\u062a \u2014 \u0628\u0631\u0627\u06cc \u0642\u0627\u0644\u0628\u200c\u0628\u0646\u062f\u06cc \u0627\u0632 \u2699 \u06cc\u0627 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0628\u0644\u0648\u06a9 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f"],"This block keeps custom styling \u2014 change its type in the block editor":["\u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u0633\u0628\u06a9 \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0627 \u062d\u0641\u0638 \u0645\u06cc\u200c\u06a9\u0646\u062f \u2014 \u0646\u0648\u0639 \u0622\u0646 \u0631\u0627 \u062f\u0631 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0628\u0644\u0648\u06a9 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f"],"Caption":["\u062a\u0648\u0636\u06cc\u062d \u062a\u0635\u0648\u06cc\u0631"],"This block\u2019s content can\u2019t be edited here.":["\u0645\u062d\u062a\u0648\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u0631\u0627 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646 \u0627\u06cc\u0646\u062c\u0627 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u06a9\u0631\u062f."],"Edit content":["\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0645\u062d\u062a\u0648\u0627"],"Text first; each block\u2019s other settings are tucked below it.":["\u0627\u0628\u062a\u062f\u0627 \u0645\u062a\u0646\u061b \u0633\u0627\u06cc\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0647\u0631 \u0628\u0644\u0648\u06a9 \u0632\u06cc\u0631 \u0622\u0646 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u0646\u062f."],"Text first; each block\u2019s other settings are tucked below it. This block\u2019s structure is locked.":["\u0627\u0628\u062a\u062f\u0627 \u0645\u062a\u0646\u061b \u0633\u0627\u06cc\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0647\u0631 \u0628\u0644\u0648\u06a9 \u0632\u06cc\u0631 \u0622\u0646 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u0646\u062f. \u0633\u0627\u062e\u062a\u0627\u0631 \u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u0642\u0641\u0644 \u0627\u0633\u062a."],"Loading block schema\u2026":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0634\u0650\u0645\u0627\u06cc \u0628\u0644\u0648\u06a9\u2026"],"Cancel":["\u0644\u063a\u0648"],"Apply":["\u0627\u0639\u0645\u0627\u0644"],"Settings (%d)":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a (%d)"],"Move up":["\u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u0647 \u0628\u0627\u0644\u0627"],"Move down":["\u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u0647 \u067e\u0627\u06cc\u06cc\u0646"],"Remove":["\u062d\u0630\u0641"],"No editable settings.":["\u0647\u06cc\u0686 \u062a\u0646\u0638\u06cc\u0645 \u0642\u0627\u0628\u0644\u200c\u0648\u06cc\u0631\u0627\u06cc\u0634\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f."],"No blocks left. Add one, or Cancel and remove the whole block from its \u2699 popover instead.":["\u0647\u06cc\u0686 \u0628\u0644\u0648\u06a9\u06cc \u0628\u0627\u0642\u06cc \u0646\u0645\u0627\u0646\u062f\u0647 \u0627\u0633\u062a. \u06cc\u06a9\u06cc \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f\u060c \u06cc\u0627 \u0644\u063a\u0648 \u06a9\u0646\u06cc\u062f \u0648 \u06a9\u0644 \u0628\u0644\u0648\u06a9 \u0631\u0627 \u0627\u0632 \u067e\u0646\u062c\u0631\u0647\u0654 \u0628\u0627\u0632\u0634\u0648\u06cc \u2699 \u0622\u0646 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f."],"Add":["\u0627\u0641\u0632\u0648\u062f\u0646"],"block":["\u0628\u0644\u0648\u06a9"],"More settings (%d)":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u06cc\u0634\u062a\u0631 (%d)"],"Fewer settings":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06a9\u0645\u062a\u0631"],"Block updated":["\u0628\u0644\u0648\u06a9 \u0628\u0647\u200c\u0631\u0648\u0632 \u0634\u062f"],"This block could not be updated.":["\u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u0628\u0647\u200c\u0631\u0648\u0632 \u0646\u0634\u062f."],"Link, size and lightbox options live in the block editor.":["\u06af\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u067e\u06cc\u0648\u0646\u062f\u060c \u0627\u0646\u062f\u0627\u0632\u0647 \u0648 \u0644\u0627\u06cc\u062a\u200c\u0628\u0627\u06a9\u0633 \u062f\u0631 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0628\u0644\u0648\u06a9 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u0646\u062f."],"Content \u00b7 %d block":["\u0645\u062d\u062a\u0648\u0627 \u00b7 %d \u0628\u0644\u0648\u06a9","\u0645\u062d\u062a\u0648\u0627 \u00b7 %d \u0628\u0644\u0648\u06a9"],"Edit content\u2026":["\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0645\u062d\u062a\u0648\u0627\u2026"],"Syntax highlighting":["\u0628\u0631\u062c\u0633\u062a\u0647\u200c\u0633\u0627\u0632\u06cc \u0646\u062d\u0648"],"Remove this code block":["\u062d\u0630\u0641 \u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u06a9\u062f"],"(untitled pattern)":["(\u0627\u0644\u06af\u0648\u06cc \u0628\u062f\u0648\u0646 \u0639\u0646\u0648\u0627\u0646)"],"Your patterns":["\u0627\u0644\u06af\u0648\u0647\u0627\u06cc \u0634\u0645\u0627"],"Synced":["\u0647\u0645\u06af\u0627\u0645"],"Pattern unavailable":["\u0627\u0644\u06af\u0648 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a"],"Pattern insert failed: %s":["\u062f\u0631\u062c \u0627\u0644\u06af\u0648 \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f: %s"],"Updating %s plugin\u2026":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0627\u0641\u0632\u0648\u0646\u0647\u0654 %s\u2026","\u062f\u0631 \u062d\u0627\u0644 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc %s \u0627\u0641\u0632\u0648\u0646\u0647\u2026"],"Browse database (read-only)":["\u0645\u0631\u0648\u0631 \u067e\u0627\u06cc\u06af\u0627\u0647 \u062f\u0627\u062f\u0647 (\u0641\u0642\u0637\u200c\u062e\u0648\u0627\u0646\u062f\u0646\u06cc)"],"Open the user guide":["\u0628\u0627\u0632\u06a9\u0631\u062f\u0646 \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631"],"Versions":["\u0646\u0633\u062e\u0647\u200c\u0647\u0627"],"View the full changelog with screenshots on minnadmin.com":["\u0645\u0634\u0627\u0647\u062f\u0647\u0654 \u06af\u0632\u0627\u0631\u0634 \u06a9\u0627\u0645\u0644 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u062a\u0635\u0648\u06cc\u0631 \u062f\u0631 minnadmin.com"],"User guide":["\u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631"],"Loading the guide\u2026":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0631\u0627\u0647\u0646\u0645\u0627\u2026"],"Minn is a reimagined WordPress admin.":["Minn \u062a\u062c\u0631\u0628\u0647\u200c\u0627\u06cc \u0646\u0648 \u0627\u0632 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648\u0631\u062f\u067e\u0631\u0633 \u0627\u0633\u062a."],"A calm, fast surface for the work you do every day: writing, moderating, uploading, and keeping an eye on the site. Classic wp-admin stays fully available, one click away.":["\u0645\u062d\u06cc\u0637\u06cc \u0622\u0631\u0627\u0645 \u0648 \u0633\u0631\u06cc\u0639 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0647\u0627\u06cc \u0631\u0648\u0632\u0645\u0631\u0647: \u0646\u0648\u0634\u062a\u0646\u060c \u0628\u0627\u0632\u0628\u06cc\u0646\u06cc\u060c \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0648 \u0632\u06cc\u0631 \u0646\u0638\u0631 \u062f\u0627\u0634\u062a\u0646 \u0633\u0627\u06cc\u062a. wp-admin \u06a9\u0644\u0627\u0633\u06cc\u06a9 \u0647\u0645\u0686\u0646\u0627\u0646 \u06a9\u0627\u0645\u0644 \u0648 \u0628\u0627 \u06cc\u06a9 \u06a9\u0644\u06cc\u06a9 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0627\u0633\u062a."],"Getting around":["\u06af\u0634\u062a\u200c\u0648\u06af\u0630\u0627\u0631"],"The sidebar has three groups: Workspace (the daily material), Tools (what your plugins add) and Manage (the site itself). The fastest way anywhere is the command palette:":["\u0646\u0648\u0627\u0631 \u06a9\u0646\u0627\u0631\u06cc \u0633\u0647 \u06af\u0631\u0648\u0647 \u062f\u0627\u0631\u062f: \u0641\u0636\u0627\u06cc \u06a9\u0627\u0631\u06cc (\u0645\u062d\u062a\u0648\u0627\u06cc \u0631\u0648\u0632\u0645\u0631\u0647)\u060c \u0627\u0628\u0632\u0627\u0631\u0647\u0627 (\u0645\u0648\u0627\u0631\u062f \u0627\u0641\u0632\u0648\u062f\u0647\u200c\u0634\u062f\u0647 \u062a\u0648\u0633\u0637 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627) \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a (\u062e\u0648\u062f \u0633\u0627\u06cc\u062a). \u0633\u0631\u06cc\u0639\u200c\u062a\u0631\u06cc\u0646 \u0631\u0627\u0647 \u0628\u0631\u0627\u06cc \u0631\u0641\u062a\u0646 \u0628\u0647 \u0647\u0631\u062c\u0627\u060c \u067e\u0627\u0644\u062a \u0641\u0631\u0645\u0627\u0646 \u0627\u0633\u062a:"],", then start typing a view, a post or a command.":["\u060c \u0633\u067e\u0633 \u0646\u0627\u0645 \u06cc\u06a9 \u0646\u0645\u0627\u060c \u0646\u0648\u0634\u062a\u0647 \u06cc\u0627 \u0641\u0631\u0645\u0627\u0646 \u0631\u0627 \u062a\u0627\u06cc\u067e \u06a9\u0646\u06cc\u062f."],"Right-click almost anything":["\u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0631\u0648\u06cc \u0647\u0631\u0686\u06cc\u0632\u06cc \u0631\u0627\u0633\u062a\u200c\u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f"],"The least discoverable thing in Minn, so here it is in writing: rows in Content and Media, comments, the theme button, plugin entries in the sidebar and group headings in the block library all have right-click menus. When in doubt, try a right-click.":["\u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u06a9\u0645\u062a\u0631 \u0627\u0632 \u0647\u0645\u0647 \u062f\u0631 Minn \u062f\u06cc\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u067e\u0633 \u0627\u06cc\u0646\u062c\u0627 \u0631\u0648\u0634\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u06cc\u0645: \u0631\u062f\u06cc\u0641\u200c\u0647\u0627\u06cc \u0645\u062d\u062a\u0648\u0627 \u0648 \u0631\u0633\u0627\u0646\u0647\u060c \u062f\u06cc\u062f\u06af\u0627\u0647\u200c\u0647\u0627\u060c \u062f\u06a9\u0645\u0647\u0654 \u067e\u0648\u0633\u062a\u0647\u060c \u0648\u0631\u0648\u062f\u06cc\u200c\u0647\u0627\u06cc \u0627\u0641\u0632\u0648\u0646\u0647 \u062f\u0631 \u0646\u0648\u0627\u0631 \u06a9\u0646\u0627\u0631\u06cc \u0648 \u0639\u0646\u0648\u0627\u0646 \u06af\u0631\u0648\u0647\u200c\u0647\u0627 \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u0654 \u0628\u0644\u0648\u06a9 \u0647\u0645\u06af\u06cc \u0645\u0646\u0648\u06cc \u0631\u0627\u0633\u062a\u200c\u06a9\u0644\u06cc\u06a9 \u062f\u0627\u0631\u0646\u062f. \u0647\u0631 \u0648\u0642\u062a \u062a\u0631\u062f\u06cc\u062f \u062f\u0627\u0634\u062a\u06cc\u062f\u060c \u0631\u0627\u0633\u062a\u200c\u06a9\u0644\u06cc\u06a9 \u0631\u0627 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f."],"Make it yours":["\u0622\u0646 \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0646\u06cc\u0627\u0632 \u062e\u0648\u062f \u06a9\u0646\u06cc\u062f"],"Anything a plugin adds here can be hidden for you alone: right-click its sidebar entry or block-library heading and choose Hide. Everything hidden is listed on Your profile, where one click restores it.":["\u0647\u0631 \u0686\u06cc\u0632\u06cc \u06a9\u0647 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0627\u06cc \u0627\u06cc\u0646\u062c\u0627 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0641\u0642\u0637 \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0642\u0627\u0628\u0644\u200c\u067e\u0646\u0647\u0627\u0646\u200c\u06a9\u0631\u062f\u0646 \u0627\u0633\u062a: \u0631\u0648\u06cc \u0648\u0631\u0648\u062f\u06cc \u0646\u0648\u0627\u0631 \u06a9\u0646\u0627\u0631\u06cc \u06cc\u0627 \u0639\u0646\u0648\u0627\u0646 \u0622\u0646 \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u0654 \u0628\u0644\u0648\u06a9 \u0631\u0627\u0633\u062a\u200c\u06a9\u0644\u06cc\u06a9 \u0648 \u00ab\u067e\u0646\u0647\u0627\u0646\u200c\u06a9\u0631\u062f\u0646\u00bb \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f. \u0647\u0645\u0647\u0654 \u0645\u0648\u0627\u0631\u062f \u067e\u0646\u0647\u0627\u0646 \u062f\u0631 \u0646\u0645\u0627\u06cc\u0647\u0654 \u0634\u0645\u0627 \u0641\u0647\u0631\u0633\u062a \u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u0648 \u0628\u0627 \u06cc\u06a9 \u06a9\u0644\u06cc\u06a9 \u0628\u0627\u0632\u0645\u06cc\u200c\u06af\u0631\u062f\u0646\u062f."],"Deliberately minimal":["\u0639\u0645\u062f\u0627\u064b \u0645\u06cc\u0646\u06cc\u0645\u0627\u0644"],"Minn surfaces the settings people change day to day; the long tail stays in wp-admin on purpose. For plugin configuration Minn doesn't rebuild, open":["Minn \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\u06cc \u0631\u0627 \u0646\u0645\u0627\u06cc\u0634 \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0631\u0648\u0632\u0627\u0646\u0647 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u062f\u0647\u0646\u062f\u061b \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06a9\u0645\u200c\u06a9\u0627\u0631\u0628\u0631\u062f \u0639\u0645\u062f\u0627\u064b \u062f\u0631 wp-admin \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f. \u0628\u0631\u0627\u06cc \u067e\u06cc\u06a9\u0631\u0628\u0646\u062f\u06cc \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 Minn \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f:"],"Your profile \u2192 AI Access":["\u0646\u0645\u0627\u06cc\u0647\u0654 \u0634\u0645\u0627 \u2192 \u062f\u0633\u062a\u0631\u0633\u06cc \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc"]," and hand your AI agent a revocable credential to do the fiddly work over the REST API.":[" \u0648 \u06cc\u06a9 \u0627\u0639\u062a\u0628\u0627\u0631\u0646\u0627\u0645\u0647\u0654 \u0642\u0627\u0628\u0644\u200c\u0644\u063a\u0648 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0639\u0627\u0645\u0644 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u062e\u0648\u062f \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u062a\u0627 \u06a9\u0627\u0631\u0647\u0627\u06cc \u0638\u0631\u06cc\u0641 \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 REST API \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u062f."],"Everything Minn writes is native WordPress: real block markup, core options, core users. Deactivate the plugin and nothing is lost. Plugins extend Minn with one PHP filter, as plain data, which is why nothing here can nag you.":["\u0647\u0631\u0686\u0647 Minn \u0645\u06cc\u200c\u0646\u0648\u06cc\u0633\u062f \u0628\u0648\u0645\u06cc \u0648\u0631\u062f\u067e\u0631\u0633 \u0627\u0633\u062a: \u0646\u0634\u0627\u0646\u0647\u200c\u06af\u0630\u0627\u0631\u06cc \u0648\u0627\u0642\u0639\u06cc \u0628\u0644\u0648\u06a9\u060c \u06af\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0647\u0633\u062a\u0647 \u0648 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0647\u0633\u062a\u0647. \u0628\u0627 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644\u200c\u06a9\u0631\u062f\u0646 \u0627\u0641\u0632\u0648\u0646\u0647 \u0686\u06cc\u0632\u06cc \u0627\u0632 \u062f\u0633\u062a \u0646\u0645\u06cc\u200c\u0631\u0648\u062f. \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627 Minn \u0631\u0627 \u0628\u0627 \u06cc\u06a9 \u0641\u06cc\u0644\u062a\u0631 PHP \u0648 \u0628\u0647\u200c\u0634\u06a9\u0644 \u062f\u0627\u062f\u0647\u0654 \u0633\u0627\u062f\u0647 \u06af\u0633\u062a\u0631\u0634 \u0645\u06cc\u200c\u062f\u0647\u0646\u062f\u061b \u0628\u0647 \u0647\u0645\u06cc\u0646 \u062f\u0644\u06cc\u0644 \u0686\u06cc\u0632\u06cc \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0645\u0632\u0627\u062d\u0645 \u0634\u0645\u0627 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f."],"Copied (truncated value)":["\u06a9\u067e\u06cc \u0634\u062f (\u0645\u0642\u062f\u0627\u0631 \u06a9\u0648\u062a\u0627\u0647\u200c\u0634\u062f\u0647)"],"Value copied":["\u0645\u0642\u062f\u0627\u0631 \u06a9\u067e\u06cc \u0634\u062f"],"No guide found.":["\u0631\u0627\u0647\u0646\u0645\u0627\u06cc\u06cc \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f."],"Could not load this user.":["\u0627\u06cc\u0646 \u06a9\u0627\u0631\u0628\u0631 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0646\u0634\u062f."],"Loading user\u2026":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u06a9\u0627\u0631\u0628\u0631\u2026"],"Display name":["\u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc"],"Email":["\u0627\u06cc\u0645\u06cc\u0644"],"Role":["\u0646\u0642\u0634"],"Language":["\u0632\u0628\u0627\u0646"],"New password (leave blank to keep)":["\u0631\u0645\u0632 \u0639\u0628\u0648\u0631 \u062a\u0627\u0632\u0647 (\u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0631\u0645\u0632 \u0641\u0639\u0644\u06cc \u062e\u0627\u0644\u06cc \u0628\u06af\u0630\u0627\u0631\u06cc\u062f)"],"Generate":["\u062a\u0648\u0644\u06cc\u062f"],"Save changes":["\u0630\u062e\u06cc\u0631\u0647\u0654 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a"],"Public profile":["\u0646\u0645\u0627\u06cc\u0647\u0654 \u0639\u0645\u0648\u0645\u06cc"],"author boxes & archives":["\u062c\u0639\u0628\u0647\u200c\u0647\u0627\u06cc \u0646\u0648\u06cc\u0633\u0646\u062f\u0647 \u0648 \u0628\u0627\u06cc\u06af\u0627\u0646\u06cc\u200c\u0647\u0627"],"First name":["\u0646\u0627\u0645"],"Last name":["\u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc"],"Website":["\u0648\u0628\u200c\u0633\u0627\u06cc\u062a"],"Bio":["\u0632\u0646\u062f\u06af\u06cc\u200c\u0646\u0627\u0645\u0647"],"Appearance":["\u0646\u0645\u0627\u06cc\u0634"],"what this user sees":["\u0622\u0646\u0686\u0647 \u0627\u06cc\u0646 \u06a9\u0627\u0631\u0628\u0631 \u0645\u06cc\u200c\u0628\u06cc\u0646\u062f"],"Set their Minn palette now so it looks right before their first sign-in. Light or dark mode stays a device preference each person controls themselves.":["\u067e\u0627\u0644\u062a Minn \u0627\u06cc\u0646 \u06a9\u0627\u0631\u0628\u0631 \u0631\u0627 \u0627\u06a9\u0646\u0648\u0646 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u067e\u06cc\u0634 \u0627\u0632 \u0646\u062e\u0633\u062a\u06cc\u0646 \u0648\u0631\u0648\u062f \u062f\u0631\u0633\u062a \u0628\u0647 \u06